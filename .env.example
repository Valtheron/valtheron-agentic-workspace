# =============================================================================
#  Valtheron Agentic Workspace – Public Environment Configuration
# =============================================================================
#  Format: .env (KEY=VALUE, ein Eintrag pro Zeile, kein Shell-Quoting nötig).
#  Sichtbarkeit: Diese Datei ist öffentlich. KEINE Secrets, Tokens, API-Keys,
#  Passwörter, Connection-Strings mit Credentials oder JWT-Secrets ablegen.
#  Secrets gehören ausschließlich in den geheimen Secret-Store des Providers
#  (Claude Cloud Secrets, GitHub Actions Secrets, Docker Secrets, Vault o. ä.).
# =============================================================================


# -----------------------------------------------------------------------------
#  1) Runtime & Process
# -----------------------------------------------------------------------------
NODE_ENV=development
TZ=Europe/Berlin
LANG=de_DE.UTF-8
LC_ALL=de_DE.UTF-8

# Node V8 Heap & Source-Map Support (4 GB Heap, saubere Stacktraces)
NODE_OPTIONS=--max-old-space-size=4096 --enable-source-maps
UV_THREADPOOL_SIZE=16

# npm / pnpm Verhalten in CI & Cloud-Sessions
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false
NPM_CONFIG_UPDATE_NOTIFIER=false
NPM_CONFIG_PROGRESS=false
CI=false


# -----------------------------------------------------------------------------
#  2) Backend (Express API)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
PORT=3001
TRUST_PROXY=1
BODY_LIMIT=2mb
REQUEST_ID_HEADER=x-request-id
SHUTDOWN_GRACE_PERIOD_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000

# CORS (Whitelist per Komma getrennt; '*' nur in Dev verwenden)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
CORS_CREDENTIALS=true
CORS_MAX_AGE=600

# Rate-Limiting (sliding window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SKIP_SUCCESSFUL=false


# -----------------------------------------------------------------------------
#  3) Frontend (Vite + React)
# -----------------------------------------------------------------------------
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3001/api
VITE_WS_BASE_URL=ws://localhost:3001/ws
VITE_APP_NAME=Valtheron Agentic Workspace
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_LOCALE=de-DE
VITE_DEFAULT_THEME=system
VITE_ENABLE_DEVTOOLS=true


# -----------------------------------------------------------------------------
#  4) Datenbank (SQLite / better-sqlite3) + optionaler Pool
# -----------------------------------------------------------------------------
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/valtheron.db
DATABASE_JOURNAL_MODE=WAL
DATABASE_SYNCHRONOUS=NORMAL
DATABASE_FOREIGN_KEYS=true
DATABASE_BUSY_TIMEOUT_MS=5000

# Generische Pool-Parameter (für zukünftige Postgres/MySQL-Migration)
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Migrations
DB_MIGRATIONS_DIR=./backend/src/migrations
DB_MIGRATIONS_AUTO=true
DB_SEED_ON_EMPTY=false


# -----------------------------------------------------------------------------
#  5) API-Client Policies (Retries, Timeouts, Circuit Breaker)
# -----------------------------------------------------------------------------
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_BASE_DELAY_MS=500
API_RETRY_MAX_DELAY_MS=8000
API_RETRY_JITTER=true
API_RETRY_ON_STATUS=408,425,429,500,502,503,504
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=30000


# -----------------------------------------------------------------------------
#  6) Agentic / LLM-Provider (nur Nicht-Secrets, Keys gehören in Secret-Store)
# -----------------------------------------------------------------------------
# Anthropic (Claude)
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_PROMPT_CACHING=true
ANTHROPIC_REQUEST_TIMEOUT_MS=60000

# OpenAI
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_MS=60000

# Agent-Orchestrierung
AGENT_MAX_CONCURRENCY=4
AGENT_STEP_TIMEOUT_MS=120000
AGENT_TOTAL_TIMEOUT_MS=600000
AGENT_TOOL_CALL_LIMIT=32
AGENT_CONTEXT_WINDOW_TOKENS=200000
AGENT_MEMORY_DIR=./data/agent-memory


# -----------------------------------------------------------------------------
#  7) Caching (In-Memory LRU; Redis optional via Host ohne Credentials)
# -----------------------------------------------------------------------------
CACHE_DRIVER=memory
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ITEMS=10000
CACHE_NAMESPACE=valtheron

# Redis (optional – Host/Port ohne Auth, Auth-Tokens via Secret-Store)
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false


# -----------------------------------------------------------------------------
#  8) Observability: Logging, Metrics, Tracing
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_COLOR=false
LOG_PRETTY=false
LOG_INCLUDE_REQUEST_ID=true
LOG_REDACT_FIELDS=authorization,cookie,set-cookie,password,token,apiKey

# Prometheus-kompatible Metrics
METRICS_ENABLED=true
METRICS_ROUTE=/metrics
METRICS_DEFAULT_LABELS=service=valtheron-backend,env=dev

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=valtheron-backend
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf


# -----------------------------------------------------------------------------
#  9) Health, Readiness & Liveness
# -----------------------------------------------------------------------------
ENABLE_HEALTH_CHECKS=true
HEALTHCHECK_ROUTE=/api/health
READINESS_ROUTE=/api/ready
LIVENESS_ROUTE=/api/live
HEALTHCHECK_INTERVAL_MS=30000
HEALTHCHECK_TIMEOUT_MS=5000
HEALTHCHECK_FAIL_THRESHOLD=3


# -----------------------------------------------------------------------------
# 10) Sicherheit (nur Policy-Parameter, KEINE Secrets)
# -----------------------------------------------------------------------------
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_FRAME_DENY=true
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_XSS_PROTECTION=1; mode=block

# Session/JWT – nur Policy, Secret via Secret-Store!
SESSION_COOKIE_NAME=valtheron.sid
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true
JWT_ISSUER=valtheron
JWT_AUDIENCE=valtheron-clients
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# 2FA / TOTP
TOTP_ISSUER=Valtheron
TOTP_DIGITS=6
TOTP_PERIOD=30
TOTP_WINDOW=1


# -----------------------------------------------------------------------------
# 11) Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AGENT_MARKETPLACE=true
FEATURE_CYBERSEC_DATABASE=true
FEATURE_KNOWLEDGE_BASE=true
FEATURE_STRIPE_BILLING=false
FEATURE_WEBSOCKET_LIVE_UPDATES=true
FEATURE_EXPERIMENTAL_UI=false


# -----------------------------------------------------------------------------
# 12) Testing & Qualität
# -----------------------------------------------------------------------------
TEST_TIMEOUT_MS=30000
TEST_COVERAGE_THRESHOLD=80
TEST_PARALLEL=true
TEST_RETRIES=1
PLAYWRIGHT_HEADLESS=true


# -----------------------------------------------------------------------------
# 13) Build- & Deployment-Metadaten
# -----------------------------------------------------------------------------
APP_NAME=valtheron-agentic-workspace
APP_VERSION=1.0.0
APP_COMMIT_SHA=
APP_BUILD_TIME=
APP_RELEASE_CHANNEL=dev


# -----------------------------------------------------------------------------
# 14) Claude Code Cloud-Session (nur Verhaltens-Flags)
# -----------------------------------------------------------------------------
CLAUDE_CODE_SHELL=bash
CLAUDE_CODE_DISABLE_TELEMETRY=1
CLAUDE_CODE_LOG_LEVEL=info
CLAUDE_CODE_DEFAULT_BRANCH=main
