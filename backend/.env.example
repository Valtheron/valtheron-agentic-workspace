# ===== Valtheron Backend Environment Variables =====

# Server
PORT=3001
NODE_ENV=development

# Authentication
# SECURITY: Generate a strong secret for production, e.g.:  openssl rand -hex 32
# In production (NODE_ENV=production), the server refuses to start with this default.
JWT_SECRET=valtheron-dev-secret-change-in-production

# Force JWT authentication even in development (default: false; always enforced in production)
# Set to "true" to exercise the production auth flow locally.
# VALTHERON_REQUIRE_AUTH=false

# LLM Providers (optional — used by chat routes)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CORS origins (comma-separated, defaults to localhost dev ports)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Stripe (Donations)
STRIPE_SECRET_KEY=
# Frontend URL for Stripe checkout redirects (defaults to http://localhost:5173)
# STRIPE_FRONTEND_URL=http://localhost:5173

# Web browsing (Playwright MCP) — POST /api/browse
# BROWSE_ENABLED=true                # set to "false" to disable browsing entirely
# BROWSE_ALLOWLIST=example.com,docs.python.org   # optional comma-separated domain allowlist (empty = any public host)
# BROWSE_IGNORE_HTTPS_ERRORS=false   # ONLY for dev behind a TLS-intercepting proxy; never true in production
