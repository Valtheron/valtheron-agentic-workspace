# ===== Valtheron Frontend Environment Variables =====

# API base URL (uses Vite proxy by default in dev)
# VITE_API_URL=/api

# WebSocket URL (auto-detected from window.location by default)
# VITE_WS_URL=ws://localhost:3001/ws

# Force the login screen in dev (production builds always require auth).
# Set to "true" when testing the production auth flow against `npm run dev`.
# VITE_VALTHERON_REQUIRE_AUTH=false
